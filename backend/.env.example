ENVIRONMENT=development

# Postgres -- must have the pgvector extension available (CREATE EXTENSION vector).
# The app creates the extension itself on startup if the connecting role has permission.
DATABASE_URL=postgresql+asyncpg://merchantgpt:change_me@localhost:5432/merchantgpt
DATABASE_URL_SYNC=postgresql+psycopg2://merchantgpt:change_me@localhost:5432/merchantgpt

JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Used only by app/services/campaign.py to polish campaign copy and
# the weekly report narrative -- both degrade to rule-based/template output
# without it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Optional. Powers the /chat endpoint's tool-calling agent (app/agent/gemini_client.py).
# Without it, /chat/messages returns a clear "not configured" message instead of
# crashing -- every other MerchantGPT feature is unaffected either way.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

EMBEDDING_DIMENSION=512
